<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="office_world">
    <!-- Physics -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- Ground Plane -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Sun -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Outer Walls (8m x 6m) -->
    <model name="outer_walls">
      <static>true</static>
      <link name="link">
        <!-- North Wall -->
        <collision name="north">
          <pose>4 0 1.25 0 0 0</pose>
          <geometry><box><size>0.1 6.0 2.5</size></box></geometry>
        </collision>
        <visual name="north_visual">
          <pose>4 0 1.25 0 0 0</pose>
          <geometry><box><size>0.1 6.0 2.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
        <!-- South Wall -->
        <collision name="south">
          <pose>-4 0 1.25 0 0 0</pose>
          <geometry><box><size>0.1 6.0 2.5</size></box></geometry>
        </collision>
        <visual name="south_visual">
          <pose>-4 0 1.25 0 0 0</pose>
          <geometry><box><size>0.1 6.0 2.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
        <!-- East Wall -->
        <collision name="east">
          <pose>0 3 1.25 0 0 0</pose>
          <geometry><box><size>8.0 0.1 2.5</size></box></geometry>
        </collision>
        <visual name="east_visual">
          <pose>0 3 1.25 0 0 0</pose>
          <geometry><box><size>8.0 0.1 2.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
        <!-- West Wall -->
        <collision name="west">
          <pose>0 -3 1.25 0 0 0</pose>
          <geometry><box><size>8.0 0.1 2.5</size></box></geometry>
        </collision>
        <visual name="west_visual">
          <pose>0 -3 1.25 0 0 0</pose>
          <geometry><box><size>8.0 0.1 2.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>

    <!-- Internal Partitions -->
    <model name="internal_wall_1">
      <static>true</static>
      <pose>0 1 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 4.0 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 4.0 2.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>

    <model name="internal_wall_2">
      <static>true</static>
      <pose>-2 -1.5 1.25 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 4.0 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 4.0 2.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>

    <!-- Furniture (Desks/Tables) -->
    <model name="desk_1">
      <static>true</static>
      <pose>2 2 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.5 0.8 0.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.5 0.8 0.8</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material>
        </visual>
      </link>
    </model>

    <model name="desk_2">
      <static>true</static>
      <pose>-2 1.5 0.4 0 0 1.57</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.5 0.8 0.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.5 0.8 0.8</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material>
        </visual>
      </link>
    </model>

    <!-- ArUco Marker Stands (IDs 0-3) -->
    <!-- We'll place them on the walls. Note: The actual marker texture depends on the marker_model -->
    <include>
      <name>marker_0</name>
      <uri>model://aruco_marker</uri>
      <pose>3.94 2 1.5 0 1.5708 0</pose>
    </include>

    <include>
      <name>marker_1</name>
      <uri>model://aruco_marker</uri>
      <pose>3.94 -2 1.5 0 1.5708 0</pose>
    </include>

    <include>
      <name>marker_2</name>
      <uri>model://aruco_marker</uri>
      <pose>-3.94 2 1.5 0 -1.5708 0</pose>
    </include>

    <include>
      <name>marker_3</name>
      <uri>model://aruco_marker</uri>
      <pose>-3.94 -2 1.5 0 -1.5708 0</pose>
    </include>

    <!-- Target Object -->
    <include>
      <uri>model://target_object</uri>
      <pose>2 -2 0.075 0 0 0</pose>
    </include>

  </world>
</sdf>
